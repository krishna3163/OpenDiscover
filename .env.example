# ─────────────────────────────────────────────────────────────
# OpenDiscover – environment template
# Copy this file to `.env` (which is git-ignored) and fill in.
#   cp .env.example .env
# ⚠️  NEVER commit a real key. A key shipped to the browser is
#     readable by every visitor – see SECURITY.md for the proxy setup.
# ─────────────────────────────────────────────────────────────

# Google AI Studio key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional: override the model used by the assistant.
VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: route AI traffic through your own proxy so the key stays server-side.
# Example: https://your-app.onrender.com/api/chat
VITE_AI_PROXY_URL=

# GitHub Pages only: the repo name becomes the base path, e.g. "/OpenDiscover/".
# Leave empty for a custom domain or a root deployment.
VITE_BASE_PATH=/

# Optional: usernames (comma separated) that get the demo "staff/admin" view.
VITE_DEMO_ADMINS=Krishna,Piyush Mishra,Md Kaif

# Optional: public site URL used for SEO/OG tags and sitemap.
VITE_SITE_URL=https://krishna3163.github.io/OpenDiscover/
