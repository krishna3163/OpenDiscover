{
  "name": "opendiscover",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OpenDiscover — a curated directory for finding, verifying and trusting open-source apps, AI models and privacy tools. Discovery metadata only: we link to official sources, we never host binaries.",
  "keywords": [
    "open-source",
    "directory",
    "discovery",
    "privacy",
    "ai-models",
    "f-droid",
    "react",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "author": "Krishna <kk3163019@gmail.com>",
  "homepage": "https://krishna3163.github.io/OpenDiscover/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishna3163/OpenDiscover.git"
  },
  "bugs": {
    "url": "https://github.com/krishna3163/OpenDiscover/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run export:data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "export:data": "node scripts/export-catalogue.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^12.23.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.7"
  }
}
